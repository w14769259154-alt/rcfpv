#!/bin/sh
# 5gipc-rc 主摄服务开机自启(固件内置, 方案2): mavfwd(经monitor) + edge(WebRTC)
### BEGIN INIT INFO
# Provides:          5gipc
### END INIT INFO

CONF=/etc/5gipc.conf
[ -f "$CONF" ] && . "$CONF"

MON=/usr/bin/5gipc-monitor
PIDFILE=/var/run/5gipc/monitor.pid
MAVPID=/var/run/5gipc/mavfwd.pid
EDGE_PID=/var/run/5gipc/edge.pid

alive() {
    [ -f "$1" ] || return 1
    p=$(cat "$1" 2>/dev/null)
    [ -n "$p" ] && [ -d "/proc/$p" ] && return 0
    return 1
}

start_edge() {
    [ "$EDGE_ENABLE" = "1" ] || return 0
    [ -x "$EDGE_BIN" ] || { echo "edge: 二进制缺失($EDGE_BIN)"; return 0; }
    if alive "$EDGE_PID"; then return 0; fi
    mkdir -p /var/run/5gipc /tmp/log/5gipc
    setsid "$EDGE_BIN" >/tmp/log/5gipc/edge.log 2>&1 &
    echo $! > "$EDGE_PID"
    sleep 1
    alive "$EDGE_PID" && echo "edge(方案2): 已启动" \
        || echo "edge(方案2): 启动失败(查 edge.log)"
}

case "$1" in
    start)
        mkdir -p /var/run/5gipc /tmp/log/5gipc
        if ! alive "$PIDFILE"; then
            setsid "$MON" >/dev/null 2>&1 &
            sleep 1
        fi
        start_edge
        alive "$PIDFILE" && echo "monitor(数传): 已启动(pid=$(cat $PIDFILE))" \
            || echo "monitor: 启动失败, 查 /tmp/log/5gipc/5gipc.log"
        ;;
    stop)
        for p in "$EDGE_PID" "$PIDFILE" "$MAVPID"; do
            if alive "$p"; then kill "$(cat "$p")" 2>/dev/null; rm -f "$p"; fi
        done
        pkill -x rcfpv-edge 2>/dev/null
        pkill -x mavfwd 2>/dev/null
        echo "5gipc 已停止"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if alive "$PIDFILE"; then
            echo "monitor: 运行中(pid=$(cat $PIDFILE))"
            alive "$MAVPID" && echo "mavfwd: 运行中(pid=$(cat $MAVPID))" \
                || echo "mavfwd: 未运行"
        else
            echo "monitor: 未运行"
        fi
        alive "$EDGE_PID" && echo "edge(方案2): 运行中" || echo "edge(方案2): 未运行"
        ip link show wg0 >/dev/null 2>&1 && echo "wg0: 存在" || echo "wg0: 不存在"
        ;;
    *)
        echo "用法: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
exit 0
