#!/bin/sh
# 5gipc-rc 音频桥开机自启(OpenIPC ultimate): 加载 USB 声卡驱动 + 启动 audio_bridge
### BEGIN INIT INFO
# Provides:          5gipc-audio
### END INIT INFO

AUD_DIR=/mnt/mmcblk0p1/5gipc/audio
LOG=/tmp/log/5gipc/audio_bridge.log

case "$1" in
    start)
        mkdir -p /tmp/log/5gipc
        # OpenIPC 默认栈仅 8KB(ulimit -s 8192),audio_bridge 主循环大缓冲
        # (UDP buf 4K+pcm 2K+opus 1.3K+tmp 2K≈10K)会栈溢出崩溃,先放大
        ulimit -s 65536
        # 1. 加载 USB 声卡驱动(幂等; 重启后模块丢失需重载)
        [ -f "$AUD_DIR/load_snd.sh" ] && sh "$AUD_DIR/load_snd.sh" start >/dev/null 2>&1
        # 等 /dev/snd 节点就绪(驱动刚加载/重启竞态:节点未建好时打开会失败退出)
        for i in 1 2 3 4 5; do
            [ -e /dev/snd/pcmC0D0c ] && break
            sleep 1
        done
        # 2. 启动 audio_bridge(双卡: -i hw:0,0 麦克风 / -p hw:1,0 扬声器; 上行 VPS:7213)
        if ! pidof audio_bridge >/dev/null 2>&1; then
            export LD_LIBRARY_PATH="$AUD_DIR/lib:$LD_LIBRARY_PATH"
            export ALSA_CONFIG_PATH="$AUD_DIR/alsa/alsa.conf"
            export ALSA_CONFIG_DIR="$AUD_DIR/alsa"
            cd "$AUD_DIR"
            setsid ./audio_bridge -l 7214 -o 10.55.0.1:7213 -i hw:0,0 -p hw:1,0 >"$LOG" 2>&1 &
        fi
        ;;
    stop)
        killall audio_bridge 2>/dev/null
        ;;
    restart)
        killall audio_bridge 2>/dev/null
        sleep 1
        "$0" start
        ;;
    status)
        if pidof audio_bridge >/dev/null 2>&1; then
            echo "audio_bridge 运行中 (pid=$(pidof audio_bridge))"
        else
            echo "audio_bridge 未运行"
        fi
        ;;
esac
exit 0
